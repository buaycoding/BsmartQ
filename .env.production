# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (Will be set by Render)
# DB_HOST=render-database-host
# DB_PORT=5432
# DB_NAME=bsmartq
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
DB_SSL=true

# System Configuration
IS_OFFLINE_MODE=false
TENANT_ID=tenant-default-001
BRANCH_NAME=Main Downtown Branch

# Security
JWT_SECRET=your-secure-jwt-secret-change-this-in-production
