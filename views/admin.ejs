<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<%- include('partials/head', { title: 'BsmartQ | Admin Console' }) %>
<body class="flex flex-col min-h-full font-sans antialiased">
  <%- include('partials/navbar') %>
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center space-x-2 bg-slate-800/80 px-3 py-1 rounded-full text-xs font-semibold text-brand-500 border border-slate-700">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <span>Super Administrator Console</span>
          </div>
          <h1 class="mt-4 text-4xl font-extrabold text-white">Manage organisations, approvals, and subscriptions</h1>
          <p class="text-slate-400 mt-2">Approve or reject organisations, control their package access, and remove any workspace when needed.</p>
        </div>
        <a href="/logout" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium px-5 py-3 rounded-lg border border-slate-700 transition">Logout</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
          <p class="text-xs text-slate-500 uppercase mb-2">Signed In As</p>
          <p class="text-lg font-bold text-white"><%= user.name %></p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
          <p class="text-xs text-slate-500 uppercase mb-2">Role</p>
          <p class="text-lg font-bold text-white"><%= user.role %></p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
          <p class="text-xs text-slate-500 uppercase mb-2">Organisations</p>
          <p class="text-lg font-bold text-white"><%= Array.isArray(organizations) ? organizations.length : 0 %></p>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mt-6 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300"><%= error %></div>
      <% } %>
      <% if (typeof notice !== 'undefined' && notice) { %>
        <div class="mt-6 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300"><%= notice %></div>
      <% } %>

      <div class="mt-8 rounded-2xl border border-slate-800 bg-slate-900 p-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Pending approvals</p>
            <h2 class="mt-2 text-2xl font-bold text-white">Organisations waiting for review</h2>
          </div>
        </div>
        <div class="mt-6 space-y-3">
          <% if (typeof pendingApprovals !== 'undefined' && pendingApprovals && pendingApprovals.length) { %>
            <% pendingApprovals.forEach(function(org) { %>
              <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                  <div>
                    <p class="font-semibold text-white"><%= org.organization_name || org.tenant_name || org.name %></p>
                    <p class="text-sm text-slate-400"><%= org.email %> • <%= org.role %></p>
                    <p class="text-xs text-slate-500 mt-1">Approved: <%= org.is_approved ? 'Yes' : 'No' %> • Active: <%= org.is_active ? 'Yes' : 'No' %> • Plan: <%= org.subscription_plan || 'free' %> • Status: <%= org.subscription_status || 'pending' %></p>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <form action="/admin/approve-user" method="POST" class="flex gap-2">
                      <input type="hidden" name="userId" value="<%= org.id %>">
                      <button type="submit" name="action" value="approve" class="rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white">Approve</button>
                      <button type="submit" name="action" value="reject" class="rounded-lg bg-slate-700 px-3 py-2 text-sm font-semibold text-white">Reject</button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p class="text-sm text-slate-400">No organisations currently need review.</p>
          <% } %>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-slate-800 bg-slate-900 p-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Organisation management</p>
            <h2 class="mt-2 text-2xl font-bold text-white">All active organisations</h2>
          </div>
        </div>
        <div class="mt-6 space-y-3">
          <% if (typeof organizations !== 'undefined' && organizations && organizations.length) { %>
            <% organizations.forEach(function(org) { %>
              <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                  <div>
                    <p class="font-semibold text-white"><%= org.organization_name || org.tenant_name || org.name %></p>
                    <p class="text-sm text-slate-400"><%= org.email %> • <%= org.tenant_id %></p>
                    <p class="text-xs text-slate-500 mt-1">Plan: <%= org.subscription_plan || 'free' %> • Payment: <%= org.subscription_status || 'pending' %> • Status: <%= org.organization_status || 'active' %></p>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <form action="/admin/approve-user" method="POST" class="flex flex-wrap gap-2">
                      <input type="hidden" name="userId" value="<%= org.id %>">
                      <select name="plan" class="rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white">
                        <option value="free" <%= (org.subscription_plan || 'free') === 'free' ? 'selected' : '' %>>Free</option>
                        <option value="1-day" <%= (org.subscription_plan || 'free') === '1-day' ? 'selected' : '' %>>1 Day</option>
                        <option value="1-month" <%= (org.subscription_plan || 'free') === '1-month' ? 'selected' : '' %>>1 Month</option>
                        <option value="3-months" <%= (org.subscription_plan || 'free') === '3-months' ? 'selected' : '' %>>3 Months</option>
                        <option value="1-year" <%= (org.subscription_plan || 'free') === '1-year' ? 'selected' : '' %>>1 Year</option>
                      </select>
                      <select name="paymentStatus" class="rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white">
                        <option value="pending" <%= (org.subscription_status || 'pending') === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="paid" <%= (org.subscription_status || 'pending') === 'paid' ? 'selected' : '' %>>Paid</option>
                        <option value="inactive" <%= (org.subscription_status || 'pending') === 'inactive' ? 'selected' : '' %>>Inactive</option>
                      </select>
                      <button type="submit" name="action" value="update-plan" class="rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white">Save package</button>
                      <button type="submit" name="action" value="delete" class="rounded-lg bg-rose-600 px-3 py-2 text-sm font-semibold text-white">Delete</button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p class="text-sm text-slate-400">No organisations available yet.</p>
          <% } %>
        </div>
      </div>
    </div>
  </section>
  <%- include('partials/footer') %>
</body>
</html>
