<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<%- include('partials/head', { title: 'BsmartQ | AI Analytics' }) %>
<body class="flex flex-col min-h-full font-sans antialiased">
  <%- include('partials/navbar') %>
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <div class="inline-flex items-center space-x-2 bg-slate-800/80 px-3 py-1 rounded-full text-xs font-semibold text-amber-400 border border-slate-700">
          <i class="fa-solid fa-brain"></i>
          <span>AI Predictive Routing</span>
        </div>
        <h1 class="mt-4 text-4xl font-extrabold text-white">Branch intelligence dashboard</h1>
        <p class="text-slate-400 mt-2">Model recommendations guide staffing, queue balancing, and service-time optimization.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
          <p class="text-xs text-slate-500 uppercase mb-2">Load Forecast</p>
          <p class="text-3xl font-bold text-white"><%= loadForecast %></p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
          <p class="text-xs text-slate-500 uppercase mb-2">Recommended Staff</p>
          <p class="text-3xl font-bold text-sky-400"><%= recommendedStaff %></p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
          <p class="text-xs text-slate-500 uppercase mb-2">AI Confidence</p>
          <p class="text-3xl font-bold text-emerald-400"><%= aiConfidence %></p>
        </div>
      </div>

      <div class="mt-6 bg-slate-900 border border-slate-800 rounded-xl p-6">
        <p class="text-xs text-slate-500 uppercase mb-2">Branch Health</p>
        <p class="text-lg font-semibold text-white"><%= branchHealth %></p>
      </div>
    </div>
  </section>
  <%- include('partials/footer') %>
</body>
</html>
