<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<%- include('../partials/head', { title: 'BsmartQ | Sign In' }) %>
<body class="flex flex-col min-h-full font-sans antialiased">
  <%- include('../partials/navbar') %>
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div class="space-y-5">
          <div class="inline-flex items-center space-x-2 bg-slate-800/80 px-3 py-1 rounded-full text-xs font-semibold text-brand-500 border border-slate-700">
            <i class="fa-solid fa-shield-heart"></i>
            <span>Secure Access</span>
          </div>
          <h1 class="text-4xl font-extrabold text-white">Sign in to your BsmartQ workspace</h1>
          <p class="text-slate-400">Access branch queue operations, staff tools, scheduling, analytics, and live branch controls.</p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl">
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-4 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300"><%= error %></div>
          <% } %>
          <% if (typeof notice !== 'undefined' && notice) { %>
            <div class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300"><%= notice %></div>
          <% } %>
          <form action="/login" method="POST" class="space-y-4">
            <div>
              <label class="block text-sm text-slate-300 mb-2">Email address</label>
              <input type="email" name="email" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:outline-none focus:border-brand-500" placeholder="name@example.com" required>
            </div>
            <div>
              <label class="block text-sm text-slate-300 mb-2">Password</label>
              <input type="password" name="password" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:outline-none focus:border-brand-500" placeholder="Enter your password" required>
            </div>
            <button type="submit" class="w-full bg-brand-600 hover:bg-brand-500 text-white font-semibold px-4 py-3 rounded-lg transition">Sign In</button>
          </form>
          <div class="mt-5 text-sm text-slate-400">
            Need an account?
            <a href="/register" class="text-brand-500 hover:text-brand-400">Create one</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <%- include('../partials/footer') %>
</body>
</html>
