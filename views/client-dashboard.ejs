<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<%- include('partials/head', { title: 'BsmartQ | Client Dashboard' }) %>
<body class="min-h-full bg-slate-950 font-sans antialiased">
  <%- include('partials/navbar') %>
  <section class="py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 p-6 shadow-2xl shadow-slate-950/40">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Client portal</p>
            <h1 class="mt-2 text-3xl font-extrabold text-white">Welcome back, <%= user.name %></h1>
            <p class="mt-2 text-sm text-slate-400">Track your queue, manage bookings, and stay updated with your activity.</p>
          </div>
          <a href="/logout" class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-2 text-sm font-semibold text-slate-200">Logout</a>
        </div>
      </div>

      <% if (typeof notice !== 'undefined' && notice) { %>
        <div class="mb-6 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300"><%= notice %></div>
      <% } %>

      <div class="grid grid-cols-1 gap-6 xl:grid-cols-[1.3fr_0.7fr]">
        <div class="space-y-6">
          <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl shadow-slate-950/40">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Tracking queue</p>
                <h2 class="mt-2 text-xl font-bold text-white">Your truck queue status</h2>
              </div>
              <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-sm font-semibold text-emerald-300">Active</span>
            </div>
            <div class="mt-6 grid gap-4 md:grid-cols-3">
              <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                <p class="text-sm text-slate-400">Current queue</p>
                <p class="mt-2 text-2xl font-bold text-white"><%= queueInfo.currentQueue %></p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                <p class="text-sm text-slate-400">Next slot</p>
                <p class="mt-2 text-2xl font-bold text-white"><%= queueInfo.nextSlot %></p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                <p class="text-sm text-slate-400">Estimated wait</p>
                <p class="mt-2 text-2xl font-bold text-white"><%= queueInfo.estimatedWait %></p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl shadow-slate-950/40">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-[0.24em] text-brand-400">My booking</p>
                <h2 class="mt-2 text-xl font-bold text-white">Book in advance</h2>
              </div>
            </div>
            <form action="/client/bookings" method="POST" class="mt-6 grid gap-4 md:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm text-slate-300">Service type</label>
                <input type="text" name="serviceType" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white" placeholder="Truck loading" required>
              </div>
              <div>
                <label class="mb-2 block text-sm text-slate-300">Vehicle type</label>
                <input type="text" name="vehicleType" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white" placeholder="Heavy truck" required>
              </div>
              <div>
                <label class="mb-2 block text-sm text-slate-300">Booking date</label>
                <input type="date" name="bookingDate" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white" required>
              </div>
              <div>
                <label class="mb-2 block text-sm text-slate-300">Booking time</label>
                <input type="time" name="bookingTime" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white" required>
              </div>
              <div class="md:col-span-2">
                <label class="mb-2 block text-sm text-slate-300">Notes</label>
                <textarea name="notes" rows="3" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white" placeholder="Share extra details"></textarea>
              </div>
              <div class="md:col-span-2">
                <button type="submit" class="w-full rounded-lg bg-brand-600 px-4 py-3 font-semibold text-white transition hover:bg-brand-500">Book now</button>
              </div>
            </form>

            <div class="mt-8">
              <h3 class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-400">Upcoming bookings</h3>
              <div class="mt-4 space-y-3">
                <% if (bookings && bookings.length) { %>
                  <% bookings.forEach(function(booking) { %>
                    <div class="rounded-lg border border-slate-800 bg-slate-950/70 p-3">
                      <div class="flex items-center justify-between gap-3">
                        <div>
                          <p class="font-semibold text-white"><%= booking.serviceType %></p>
                          <p class="text-sm text-slate-400"><%= booking.bookingDate %> at <%= booking.bookingTime %></p>
                        </div>
                        <span class="rounded-full border border-slate-700 bg-slate-800 px-2.5 py-1 text-xs font-medium text-slate-300"><%= booking.vehicleType %></span>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <p class="text-sm text-slate-400">No bookings yet. Create one above.</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl shadow-slate-950/40">
            <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Profile</p>
            <h2 class="mt-2 text-xl font-bold text-white">Your account details</h2>
            <div class="mt-4 space-y-3 text-sm text-slate-300">
              <div class="rounded-lg border border-slate-800 bg-slate-950/70 p-3"><span class="text-slate-400">Name:</span> <span class="ml-2 font-semibold text-white"><%= user.name %></span></div>
              <div class="rounded-lg border border-slate-800 bg-slate-950/70 p-3"><span class="text-slate-400">Email:</span> <span class="ml-2 font-semibold text-white"><%= user.email %></span></div>
              <div class="rounded-lg border border-slate-800 bg-slate-950/70 p-3"><span class="text-slate-400">Role:</span> <span class="ml-2 font-semibold text-white"><%= user.role %></span></div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl shadow-slate-950/40">
            <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Settings</p>
            <h2 class="mt-2 text-xl font-bold text-white">Notification preferences</h2>
            <form action="/client/settings" method="POST" class="mt-4 space-y-3">
              <label class="flex items-center justify-between rounded-lg border border-slate-800 bg-slate-950/70 px-3 py-3 text-sm text-slate-300">
                <span>Email updates</span>
                <input type="checkbox" name="email" <%= preferences.email ? 'checked' : '' %> class="h-4 w-4 rounded border-slate-700 bg-slate-900">
              </label>
              <label class="flex items-center justify-between rounded-lg border border-slate-800 bg-slate-950/70 px-3 py-3 text-sm text-slate-300">
                <span>SMS updates</span>
                <input type="checkbox" name="sms" <%= preferences.sms ? 'checked' : '' %> class="h-4 w-4 rounded border-slate-700 bg-slate-900">
              </label>
              <label class="flex items-center justify-between rounded-lg border border-slate-800 bg-slate-950/70 px-3 py-3 text-sm text-slate-300">
                <span>Reminders</span>
                <input type="checkbox" name="reminders" <%= preferences.reminders ? 'checked' : '' %> class="h-4 w-4 rounded border-slate-700 bg-slate-900">
              </label>
              <button type="submit" class="w-full rounded-lg bg-brand-600 px-4 py-3 font-semibold text-white transition hover:bg-brand-500">Save settings</button>
            </form>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl shadow-slate-950/40">
            <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Notifications</p>
            <h2 class="mt-2 text-xl font-bold text-white">Recent updates</h2>
            <div class="mt-4 space-y-3">
              <% notifications.forEach(function(item) { %>
                <div class="rounded-lg border border-slate-800 bg-slate-950/70 p-3">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="font-semibold text-white"><%= item.title %></p>
                      <p class="mt-1 text-sm text-slate-400"><%= item.body %></p>
                    </div>
                    <% if (item.unread) { %>
                      <span class="rounded-full bg-brand-500/20 px-2.5 py-1 text-xs font-semibold text-brand-300">New</span>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <%- include('partials/footer') %>
</body>
</html>
