<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<%- include('partials/head', { title: 'BsmartQ | Dashboard' }) %>
<body class="flex flex-col min-h-full font-sans antialiased">
  <%- include('partials/navbar') %>
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center space-x-2 bg-slate-800/80 px-3 py-1 rounded-full text-xs font-semibold text-brand-500 border border-slate-700">
            <i class="fa-solid fa-gauge-high"></i>
            <span>Authenticated Workspace</span>
          </div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.24em] text-brand-400">Company Workspace</p>
          <h1 class="mt-2 text-4xl font-extrabold text-white"><%= user.organizationName || user.name %></h1>
          <p class="text-slate-400 mt-2">Operator: <%= user.name %> • Role: <%= user.role %> • Workspace: <%= user.tenantName || user.organizationName || user.tenantId %></p>
        </div>
        <a href="/logout" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium px-5 py-3 rounded-lg border border-slate-700 transition">Logout</a>
      </div>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300"><%= error %></div>
      <% } %>
      <% if (typeof notice !== 'undefined' && notice) { %>
        <div class="mb-6 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300"><%= notice %></div>
      <% } %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 rounded-xl p-6 shadow-lg shadow-slate-950/40">
          <p class="text-xs text-slate-500 uppercase mb-2">Role</p>
          <p class="text-lg font-bold text-white"><%= user.role %></p>
        </div>
        <div class="bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 rounded-xl p-6 shadow-lg shadow-slate-950/40">
          <p class="text-xs text-slate-500 uppercase mb-2">Company</p>
          <p class="text-lg font-bold text-white"><%= user.organizationName || user.tenantName || user.tenantId %></p>
        </div>
        <div class="bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 rounded-xl p-6 shadow-lg shadow-slate-950/40">
          <p class="text-xs text-slate-500 uppercase mb-2">Branch</p>
          <p class="text-lg font-bold text-white"><%= user.branchId %></p>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl shadow-slate-950/40">
        <div class="flex items-center justify-between mb-4">
          <div>
            <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Subscription</p>
            <h2 class="text-xl font-bold text-white">Your current package and access level</h2>
          </div>
          <div class="rounded-full border border-slate-700 bg-slate-950 px-3 py-1 text-sm font-semibold text-white">
            <%= plan || 'free' %> • <%= paymentStatus || 'pending' %>
          </div>
        </div>
        <div class="mb-5 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-300">
          Send your payment to <span class="font-semibold text-white">0769356930</span> for activation.
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
          <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-4">
            <p class="text-sm font-semibold text-brand-400">Mobile money plan</p>
            <p class="mt-2 text-2xl font-bold text-white">1 day</p>
            <p class="mt-2 text-sm font-semibold <%= plan === '1-day' && paymentStatus === 'paid' ? 'text-emerald-300' : 'text-slate-400' %>">Trial access</p>
            <p class="mt-2 text-sm text-slate-400">Short trial access for quick setup and testing.</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-4">
            <p class="text-sm font-semibold text-brand-400">Mobile money plan</p>
            <p class="mt-2 text-2xl font-bold text-white">1 month</p>
            <p class="mt-2 text-sm font-semibold <%= plan === '1-month' && paymentStatus === 'paid' ? 'text-emerald-300' : 'text-slate-400' %>">Daily operations</p>
            <p class="mt-2 text-sm text-slate-400">Ideal for lightweight daily operations.</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-4">
            <p class="text-sm font-semibold text-brand-400">Mobile money plan</p>
            <p class="mt-2 text-2xl font-bold text-white">3 months</p>
            <p class="mt-2 text-sm font-semibold <%= plan === '3-months' && paymentStatus === 'paid' ? 'text-emerald-300' : 'text-slate-400' %>">Extended deployment</p>
            <p class="mt-2 text-sm text-slate-400">Great for longer-term pilot deployments.</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-4">
            <p class="text-sm font-semibold text-brand-400">Mobile money plan</p>
            <p class="mt-2 text-2xl font-bold text-white">1 year</p>
            <p class="mt-2 text-sm font-semibold <%= plan === '1-year' && paymentStatus === 'paid' ? 'text-emerald-300' : 'text-slate-400' %>">Full rollout</p>
            <p class="mt-2 text-sm text-slate-400">Best for long-running branch operations.</p>
          </div>
        </div>
        <div class="mt-5 rounded-lg border <%= hasPaidAccess ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300' : 'border-slate-700 bg-slate-950/70 text-slate-300' %> px-4 py-3 text-sm">
          <% if (hasPaidAccess) { %>
            Your organisation has paid access and can use the full workspace features for the selected package.
          <% } else { %>
            Your organisation is on the free or pending plan. Paid access unlocks the full workspace experience.
          <% } %>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-6">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl shadow-slate-950/40">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Invite Counter Team</p>
              <h2 class="text-xl font-bold text-white">Add staff who can view and update queue data</h2>
            </div>
          </div>
          <form action="/invite" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm text-slate-300 mb-2">Full name</label>
                <input type="text" name="name" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:outline-none focus:border-brand-500" required>
              </div>
              <div>
                <label class="block text-sm text-slate-300 mb-2">Email address</label>
                <input type="email" name="email" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:outline-none focus:border-brand-500" required>
              </div>
            </div>
            <div>
              <label class="block text-sm text-slate-300 mb-2">Role</label>
              <select name="role" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:outline-none focus:border-brand-500">
                <option value="counter">Counter Staff</option>
                <option value="staff">General Staff</option>
              </select>
            </div>
            <button type="submit" class="w-full bg-brand-600 hover:bg-brand-500 text-white font-semibold px-4 py-3 rounded-lg transition">Invite Team Member</button>
          </form>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl shadow-slate-950/40">
          <p class="text-xs uppercase tracking-[0.24em] text-brand-400">Workspace Members</p>
          <h2 class="text-xl font-bold text-white mt-2">Shared access</h2>
          <div class="mt-4 space-y-3">
            <% if (typeof inviteMembers !== 'undefined' && inviteMembers && inviteMembers.length) { %>
              <% inviteMembers.forEach(function(member) { %>
                <div class="rounded-lg border border-slate-800 bg-slate-950/80 p-3">
                  <div class="flex items-center justify-between gap-3">
                    <div>
                      <p class="font-semibold text-white"><%= member.name %></p>
                      <p class="text-sm text-slate-400"><%= member.email %></p>
                    </div>
                    <span class="rounded-full border border-slate-700 bg-slate-800 px-2.5 py-1 text-xs font-medium text-slate-300"><%= member.role %></span>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <p class="text-sm text-slate-400">No workspace members yet. Invite the first counter staff member.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
  <%- include('partials/footer') %>
</body>
</html>
