<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<%- include('partials/head', { title: 'BsmartQ | Offline-First AI Desktop Queue Platform' }) %>

<body class="flex flex-col min-h-full font-sans antialiased">
  <%- include('partials/navbar') %>

  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 overflow-hidden border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Column: Value Prop -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center space-x-2 bg-slate-800/80 px-3 py-1 rounded-full text-xs font-semibold text-brand-500 border border-slate-700">
            <i class="fa-solid fa-microchip"></i>
            <span>Offline-First Windows Desktop • Edge AI Sync Engine</span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
            AI-Powered <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-brand-500">Queue Intelligence</span>
          </h1>

          <p class="text-lg text-slate-400 max-w-2xl">
            A secure, installable Windows desktop queue platform that seamlessly works online and offline, automatically syncing data to the cloud when connectivity returns.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <a href="/kiosk/touch" class="bg-brand-600 hover:bg-brand-500 text-white font-medium px-6 py-3 rounded-lg shadow-lg transition flex items-center space-x-2">
              <i class="fa-solid fa-ticket"></i>
              <span>Launch Self-Service Kiosk</span>
            </a>
            <a href="/counter/operator" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium px-6 py-3 rounded-lg border border-slate-700 transition flex items-center space-x-2">
              <i class="fa-solid fa-headset"></i>
              <span>Open Operator Console</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Live Status Metrics (Dynamic Server-Rendered) -->
        <div class="lg:col-span-5">
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl relative">
            <div class="flex justify-between items-center mb-6">
              <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400">Live Branch Stats</h3>
              <span class="text-xs bg-slate-800 text-slate-300 px-2 py-1 rounded border border-slate-700">
                <i class="fa-solid fa-building-circle-check text-brand-500 mr-1"></i><%= branchName %>
              </span>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800">
                <p class="text-xs text-slate-500 mb-1">Waiting Customers</p>
                <p class="text-3xl font-bold text-white"><%= stats.waitingCount %></p>
              </div>
              <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800">
                <p class="text-xs text-slate-500 mb-1">Active Counters</p>
                <p class="text-3xl font-bold text-emerald-400"><%= stats.activeCounters %></p>
              </div>
              <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800">
                <p class="text-xs text-slate-500 mb-1">Avg Wait Time</p>
                <p class="text-3xl font-bold text-amber-400"><%= stats.avgWaitMinutes %> <span class="text-xs text-slate-500">mins</span></p>
              </div>
              <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800">
                <p class="text-xs text-slate-500 mb-1">AI Flow Efficiency</p>
                <p class="text-3xl font-bold text-sky-400"><%= stats.efficiencyScore %>%</p>
              </div>
            </div>

            <!-- Peripherals Check Widget -->
            <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
              <span class="flex items-center space-x-2">
                <i class="fa-solid fa-print <%= hardware.thermalPrinter ? 'text-emerald-400' : 'text-rose-500' %>"></i>
                <span>Printer</span>
              </span>
              <span class="flex items-center space-x-2">
                <i class="fa-solid fa-qrcode <%= hardware.qrScanner ? 'text-emerald-400' : 'text-rose-500' %>"></i>
                <span>Scanner</span>
              </span>
              <span class="flex items-center space-x-2">
                <i class="fa-solid fa-desktop <%= hardware.ledDisplay ? 'text-emerald-400' : 'text-rose-500' %>"></i>
                <span>LED Board</span>
              </span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Service Workflows Grid -->
  <section class="py-16 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-white">System Interfaces</h2>
        <p class="text-slate-400 text-sm mt-2">Access edge-ready modules tuned for secure Windows desktop queue operations.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Module Card 1 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition">
          <div class="w-12 h-12 bg-sky-500/10 text-sky-400 rounded-lg flex items-center justify-center mb-4 text-xl">
            <i class="fa-solid fa-hand-pointer"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Self-Service Touch Kiosk</h3>
          <p class="text-slate-400 text-sm mb-4">Walk-in ticket issuance with dual-language support, VIP prioritization, and thermal receipt printing. Works seamlessly online and offline.</p>
          <a href="/kiosk" class="text-brand-500 hover:text-brand-400 font-semibold text-sm inline-flex items-center">
            Launch Station <i class="fa-solid fa-arrow-right ml-1.5 text-xs"></i>
          </a>
        </div>

        <!-- Module Card 2 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition">
          <div class="w-12 h-12 bg-emerald-500/10 text-emerald-400 rounded-lg flex items-center justify-center mb-4 text-xl">
            <i class="fa-solid fa-desktop"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Live Signage & Cloud Sync Display</h3>
          <p class="text-slate-400 text-sm mb-4">Multi-zone display views with real-time queue calls, announcements, and uninterrupted operation across connected branches online and offline.</p>
          <a href="/display" class="text-emerald-400 hover:text-emerald-300 font-semibold text-sm inline-flex items-center">
            Open Display <i class="fa-solid fa-arrow-right ml-1.5 text-xs"></i>
          </a>
        </div>

        <!-- Module Card 3 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition">
          <div class="w-12 h-12 bg-amber-500/10 text-amber-400 rounded-lg flex items-center justify-center mb-4 text-xl">
            <i class="fa-solid fa-brain"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">AI Predictive Routing & Forecasting</h3>
          <p class="text-slate-400 text-sm mb-4">Dynamic load balancing and demand forecasting that help administrators predict wait times and intelligently route customers.</p>
          <a href="/analytics/ai" class="text-amber-400 hover:text-amber-300 font-semibold text-sm inline-flex items-center">
            View Analytics <i class="fa-solid fa-arrow-right ml-1.5 text-xs"></i>
          </a>
        </div>

      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>