<% const navPath = typeof currentPath !== 'undefined' ? currentPath : ''; %>
<nav class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo & Mode Badge -->
      <div class="flex items-center space-x-3">
        <div class="bg-brand-500 p-2 rounded-lg">
          <i class="fa-solid fa-layer-group text-xl text-white"></i>
        </div>
        <span class="text-xl font-bold tracking-tight">Bsmart<span class="text-brand-500">Q</span></span>
        
        <!-- Offline/Online Indicator -->
        <span id="sync-status" class="ml-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-2 h-2 mr-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
          Online & Offline Ready
        </span>
      </div>

      <!-- Navigation Links -->
      <% if (String(user && user.role || '').toLowerCase() !== 'admin') { %>
        <div class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
          <a href="/kiosk/touch" class="transition <%= navPath === '/kiosk' || navPath === '/kiosk/touch' ? 'text-white font-semibold border-b-2 border-brand-500 pb-1' : 'hover:text-white' %>">Kiosk Mode</a>
          <a href="/counter/operator" class="transition <%= navPath === '/counter/operator' ? 'text-white font-semibold border-b-2 border-brand-500 pb-1' : 'hover:text-white' %>">Counters</a>
          <a href="/display" class="transition <%= navPath === '/display' ? 'text-white font-semibold border-b-2 border-brand-500 pb-1' : 'hover:text-white' %>">Live Displays</a>
          <a href="/analytics/ai" class="transition <%= navPath === '/analytics/ai' ? 'text-white font-semibold border-b-2 border-brand-500 pb-1' : 'hover:text-white' %>">AI Insights</a>
        </div>
      <% } %>

      <!-- Action Button -->
      <div class="flex items-center space-x-4">
        <% if (user) { %>
          <% if (String(user.role || '').toLowerCase() !== 'admin') { %>
            <span class="text-sm text-slate-400">Tenant: <strong class="text-white"><%= user.tenantName || user.organizationName || user.tenantId %></strong></span>
          <% } %>
          <% if (String(user.role || '').toLowerCase() === 'admin') { %>
            <a href="/admin" class="bg-brand-600 hover:bg-brand-500 px-4 py-2 rounded-md text-sm font-semibold transition">Admin Console</a>
          <% } else { %>
            <a href="/dashboard" class="bg-brand-600 hover:bg-brand-500 px-4 py-2 rounded-md text-sm font-semibold transition">Dashboard</a>
          <% } %>
        <% } else { %>
          <a href="/register" class="bg-brand-600 hover:bg-brand-500 px-4 py-2 rounded-md text-sm font-semibold transition">Launch Workspace</a>
        <% } %>
      </div>

    </div>
  </div>
</nav>